# URL del backend; incluye /api al final. Por defecto apunta al backend deployado en AWS.
# Para desarrollar contra el backend local, cambiala segun el entorno:
#   Dispositivo físico:   http://<IP-LAN-de-tu-maquina>:8090/api   (localhost NO funciona)
#   Emulador Android:     http://10.0.2.2:8090/api
#   Simulador iOS:        http://localhost:8090/api
EXPO_PUBLIC_API_URL=http://queueless-prod-alb-1673624815.us-east-1.elb.amazonaws.com/api

# API key de Google Maps para Android; solo aplica en un development build, no en Expo Go.
# No es secreto (se restringe por package name y huella SHA), pero va fuera del repo.
# Si la dejas vacía, el mapa muestra un placeholder.
GOOGLE_MAPS_ANDROID_KEY=
