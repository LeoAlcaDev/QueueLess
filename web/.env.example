# URL base del API que consume el front. Por defecto apunta al backend desplegado en AWS
# (ALB de produccion). Para trabajar contra un backend local cambia esta variable a
# http://localhost:8090/api (Spring Boot en dev corre en 8090; en produccion es 8080).
# El ALB es HTTP: sirviendo el front en HTTP (dev en localhost) funciona sin problema.
VITE_API_URL=http://queueless-prod-alb-1673624815.us-east-1.elb.amazonaws.com/api
