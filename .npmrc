# Configuración de pnpm para QueueLess. Endurece la instalación de dependencias
# frente a paquetes maliciosos.

# SCRIPTS DE LIFECYCLE
# Los bloqueamos porque son el vector más común de ataques por cadena de suministro.
# Si un paquete legítimo necesita su postinstall, se revisa y se habilita a mano.
ignore-scripts=true
enable-pre-post-scripts=false

# VERSIONES EXACTAS
# Guardamos las versiones sin rangos en package.json para instalaciones reproducibles.
save-exact=true

# LOCKFILE
# Es la fuente de verdad: en CI y producción se instala con --frozen-lockfile.
prefer-frozen-lockfile=true

# REGISTRY OFICIAL
# Forzamos el registry oficial para evitar redirecciones a un mirror falso.
registry=https://registry.npmjs.org/

# AUDITORÍA
# Muestra las vulnerabilidades conocidas al instalar.
audit-level=moderate

# DEPENDENCIAS DECLARADAS
# Solo permite importar paquetes declarados explícitamente en package.json.
strict-peer-dependencies=true
